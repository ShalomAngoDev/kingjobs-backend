  @@index([missionId])
  @@map("mission_cancellations")
}

model MissionIncident {
  id               String                @id @default(uuid()) @db.Uuid
  missionId        String                @map("mission_id") @db.Uuid
  reportedByUserId String                @map("reported_by_user_id") @db.Uuid
