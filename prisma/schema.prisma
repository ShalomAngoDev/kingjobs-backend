model VerificationCase {
  id            String                 @id @default(uuid()) @db.Uuid
  userId        String                 @map("user_id") @db.Uuid
  kind          VerificationCaseKind
  status        VerificationCaseStatus @default(DRAFT)
  submittedAt   DateTime?              @map("submitted_at") @db.Timestamptz(6)
  reviewedAt    DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  reviewedById  String?                @map("reviewed_by_id") @db.Uuid
  userMessage   String?                @map("user_message") @db.VarChar(2000)
  internalNote  String?                @map("internal_note") @db.VarChar(2000)
  reasonCode    String?                @map("reason_code") @db.VarChar(80)
  resubmitOfId  String?                @map("resubmit_of_id") @db.Uuid
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resubmitOf VerificationCase?  @relation("VerificationResubmit", fields: [resubmitOfId], references: [id], onDelete: SetNull)
  resubmits  VerificationCase[] @relation("VerificationResubmit")
  documents  UserDocument[]

  @@index([userId, kind, status])
  @@index([status, submittedAt])
  @@index([kind, status])
  @@map("verification_cases")
}

model UserDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  documentTypeId   String                  @map("document_type_id") @db.Uuid
  verificationCaseId String?               @map("verification_case_id") @db.Uuid
  identitySubType  IdentityDocumentSubType? @map("identity_sub_type")
  status           UserDocumentStatus      @default(PENDING)
  storageKey       String                  @map("storage_key") @db.VarChar(512)
  mimeType         String                  @map("mime_type") @db.VarChar(120)
  sizeBytes        Int                     @map("size_bytes")
  originalFilename String?                 @map("original_filename") @db.VarChar(255)
  capturedAt       DateTime?               @map("captured_at") @db.Timestamptz(6)
  submittedAt      DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt       DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  reviewedById     String?                 @map("reviewed_by_id") @db.Uuid
  reasonCode       String?                 @map("reason_code") @db.VarChar(80)
  userMessage      String?                 @map("user_message") @db.VarChar(2000)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType     DocumentType      @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  verificationCase VerificationCase? @relation(fields: [verificationCaseId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  events           UserDocumentEvent[]

  @@index([userId, status])
  @@index([documentTypeId, status])
  @@index([verificationCaseId])
  @@index([status, submittedAt])
  @@map("user_documents")
}

model UserDocumentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
