// KingJOBS API — Prisma schema
// Backend 02: identité / auth / sessions
// Backend 03: catalogue services, JobberService, zones, éligibilité
// Tables pré-lancement (Next.js) : documentées dans docs/DATABASE.md — hors Migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum JobberStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
  NEEDS_CHANGES
}

enum IdentityVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CHANGES
}

enum LegalGuardianStatus {
  NOT_REQUIRED
  REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum JobberServiceStatus {
  DRAFT
  PENDING_ELIGIBILITY
  ELIGIBLE
  RESTRICTED
  SUSPENDED
}

enum ServiceRequirementType {
  MINIMUM_AGE
  DOCUMENT
  QUALIFICATION
  MANUAL_APPROVAL
  LEGAL_GUARDIAN_APPROVAL
}

enum MissionStatus {
  DRAFT
  PAYMENT_REQUIRED
  PENDING_REVIEW
  NEEDS_CHANGES
  REJECTED
  PUBLISHED
  APPLICATION_SELECTED
  CONFIRMED
  READY_TO_START
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MissionSchedulingType {
  ONCE
  CONSECUTIVE_DAYS
  SELECTED_DAYS
}

enum MissionPricingType {
  FIXED
  HOURLY
  DAILY
}

/// Sémantique du tarif horaire/journalier lorsque workersNeeded > 1.
enum MissionRateScope {
  PER_JOBBER
  TOTAL
}

enum MissionMediaType {
  IMAGE
}

/// Tentative / confirmation de paiement Mission (publication). Distinct des payouts Jobber.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum MissionWeekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum MissionReviewChangeArea {
  TITLE
  SERVICE
  DESCRIPTION
  LOCATION
  PLANNING
  WORKERS
  PRICING
  PHOTOS
  OTHER
}

enum MissionRejectionReason {
  UNAUTHORIZED_SERVICE
  DANGEROUS_REQUEST
  ILLEGAL_REQUEST
  INCONSISTENT_INFO
  OUT_OF_SCOPE
  OTHER
}

enum MissionApplicationStatus {
  PENDING
  WITHDRAWN
  SELECTED
  REJECTED
  /// Places toutes pourvues : candidature clôturée sans rejet personnel.
  MISSION_FILLED
  /// Affectation annulée après sélection (désistement / annulation slot).
  ASSIGNMENT_CANCELLED
}

enum MissionAssignmentStatus {
  ACTIVE
  CANCELLED
}

enum MissionVerificationType {
  START_CODE
  START_QR
  END_CODE
  END_QR
}

enum MissionActorType {
  CLIENT
  JOBBER
  ADMIN
  SYSTEM
}

enum MissionCancellationReason {
  CLIENT_CHANGED_MIND
  JOBBER_UNAVAILABLE
  SCHEDULE_CONFLICT
  UNSAFE_CONDITIONS
  OTHER
}

enum MissionIncidentType {
  JOBBER_NO_SHOW
  CLIENT_NO_SHOW
  SAFETY
  SERVICE_QUALITY
  PAYMENT
  BEHAVIOR
  OTHER
}

enum MissionIncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum MissionRiskFlag {
  DRIVING
  ROAD_INTERVENTION
  WORK_AT_HEIGHT
  LIVE_ELECTRICAL_WORK
  HEAVY_MACHINERY
  HAZARDOUS_EQUIPMENT
  NIGHT_SECURITY
  OTHER_RESTRICTED_ACTIVITY
}

enum UserDocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_CHANGES
  EXPIRED
}

enum VerificationCaseKind {
  IDENTITY
  JOBBER_PROFILE
}

enum VerificationCaseStatus {
  DRAFT
  PENDING
  APPROVED
  NEEDS_CHANGES
  REJECTED
}

enum JobberSkillKind {
  SKILL
  QUALITY
}

enum IdentityDocumentSubType {
  CIP
  PASSPORT
}

enum AdminAuditAction {
  VERIFY_DOCUMENT
  REJECT_DOCUMENT
  REQUEST_DOCUMENT_REPLACEMENT
  APPROVE_PROFILE
  REQUEST_PROFILE_CHANGES
  REJECT_PROFILE
  VIEW_VERIFICATION_DOCUMENT
  APPROVE_MISSION
  REQUEST_MISSION_CHANGES
  REJECT_MISSION
  SERVICE_CREATED
  SERVICE_UPDATED
  SERVICE_ENABLED
  SERVICE_DISABLED
  SERVICE_CATEGORY_CHANGED
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  firstName                  String                     @map("first_name") @db.VarChar(80)
  lastName                   String                     @map("last_name") @db.VarChar(80)
  email                      String?                    @db.VarChar(320)
  emailNormalized            String?                    @unique @map("email_normalized") @db.VarChar(320)
  phone                      String                     @unique @db.VarChar(20)
  passwordHash               String                     @map("password_hash")
  /// Nullable jusqu'à complétion profil (WEBAPP-01). Âge/KYC demandés ensuite.
  dateOfBirth                DateTime?                  @map("date_of_birth") @db.Date
  emailVerifiedAt            DateTime?                  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt            DateTime?                  @map("phone_verified_at") @db.Timestamptz(6)
  addressLine                String?                    @map("address_line") @db.VarChar(255)
  city                       String?                    @db.VarChar(120)
  countryCode                String                     @default("BJ") @map("country_code") @db.Char(2)
  administrativeArea         String?                    @map("administrative_area") @db.VarChar(120)
  status                     UserStatus                 @default(ACTIVE)
  role                       UserRole                   @default(USER)
  identityVerificationStatus IdentityVerificationStatus @default(UNVERIFIED) @map("identity_verification_status")
  legalGuardianStatus        LegalGuardianStatus        @default(NOT_REQUIRED) @map("legal_guardian_status")
  suspendedAt                DateTime?                  @map("suspended_at") @db.Timestamptz(6)
  suspensionReason           String?                    @map("suspension_reason") @db.VarChar(500)
  closedAt                   DateTime?                  @map("closed_at") @db.Timestamptz(6)
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientProfile    ClientProfile?
  jobberProfile    JobberProfile?
  sessions         Session[]
  accountTokens    AccountToken[]
  phoneOtps        PhoneOtp[]
  termsAcceptances TermsAcceptance[]
  languages        UserLanguage[]
  documents        UserDocument[]
  documentEvents   UserDocumentEvent[]     @relation("DocumentEventActor")
  verificationCases VerificationCase[]
  reviewedCases    VerificationCase[]      @relation("VerificationReviewer")
  reviewedDocuments UserDocument[]         @relation("DocumentReviewer")
  adminAuditEvents AdminAuditEvent[]       @relation("AuditActor")
  clientMissions   Mission[]            @relation("MissionClient")
  selectedMissions Mission[]            @relation("MissionSelectedJobber")
  missionApplications MissionApplication[]
  missionAssignmentsAsJobber MissionAssignment[] @relation("MissionAssignmentJobber")
  missionAssignmentsSelected MissionAssignment[] @relation("MissionAssignmentSelector")
  missionCancellations MissionCancellation[]
  missionIncidents     MissionIncident[]     @relation("IncidentReporter")
  missionStatusEvents  MissionStatusHistory[]
  missionMediaUploads  MissionMedia[]          @relation("MissionMediaUploader")
  payments             Payment[]
  notifications        UserNotification[]

  @@index([status])
  @@index([identityVerificationStatus])
  @@index([countryCode, city])
  @@map("users")
}

/// Créé à la demande (pas à l'inscription). Un User peut utiliser le Client sans profil tant qu'aucune donnée Client spécifique n'existe.
model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model JobberProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @unique @map("user_id") @db.Uuid
  status             JobberStatus @default(DRAFT)
  headline           String?      @db.VarChar(160)
  bio                String?      @db.VarChar(1000)
  yearsOfExperience  Int?         @map("years_of_experience")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     JobberService[]
  skills       JobberSkill[]
  serviceAreas JobberServiceArea[]
  educations   JobberEducation[]
  experiences  JobberExperience[]

  @@index([status])
  @@map("jobber_profiles")
}

model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(120)
  description  String?  @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  services Service[]

  @@index([isActive, displayOrder])
  @@map("service_categories")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  name             String   @db.VarChar(120)
  slug             String   @unique @db.VarChar(120)
  shortDescription String?  @map("short_description") @db.VarChar(500)
  isActive         Boolean  @default(true) @map("is_active")
  displayOrder     Int      @default(0) @map("display_order")
  minimumAge       Int      @default(16) @map("minimum_age")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requirements   ServiceRequirement[]
  jobberServices JobberService[]
  skills         JobberSkill[]
  missions       Mission[]

  @@index([categoryId, isActive, displayOrder])
  @@index([isActive])
  @@map("services")
}

model DocumentType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  requirements ServiceRequirement[]
  userDocuments UserDocument[]

  @@index([isActive])
  @@map("document_types")
}

model ServiceRequirement {
  id             String                 @id @default(uuid()) @db.Uuid
  serviceId      String                 @map("service_id") @db.Uuid
  type           ServiceRequirementType
  code           String                 @db.VarChar(80)
  label          String                 @db.VarChar(200)
  description    String?                @db.VarChar(500)
  isRequired     Boolean                @default(true) @map("is_required")
  isActive       Boolean                @default(true) @map("is_active")
  documentTypeId String?                @map("document_type_id") @db.Uuid
  configuration  Json?
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)

  @@unique([serviceId, code])
  @@index([serviceId, isActive])
  @@map("service_requirements")
}

model JobberService {
  id                    String             @id @default(uuid()) @db.Uuid
  jobberProfileId       String             @map("jobber_profile_id") @db.Uuid
  serviceId             String             @map("service_id") @db.Uuid
  experienceDescription String?            @map("experience_description") @db.VarChar(1000)
  yearsOfExperience     Int?               @map("years_of_experience")
  status                JobberServiceStatus @default(PENDING_ELIGIBILITY)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobberProfile JobberProfile @relation(fields: [jobberProfileId], references: [id], onDelete: Cascade)
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([jobberProfileId, serviceId])
  @@index([jobberProfileId, status])
  @@index([serviceId])
  @@map("jobber_services")
}

model JobberSkill {
  id              String          @id @default(uuid()) @db.Uuid
  jobberProfileId String          @map("jobber_profile_id") @db.Uuid
  serviceId       String?         @map("service_id") @db.Uuid
  /// 'profile' ou UUID service — clé technique pour unicité (évite NULL dans unique)
  scopeKey        String          @default("profile") @map("scope_key") @db.VarChar(40)
  kind            JobberSkillKind @default(SKILL)
  name            String          @db.VarChar(120)
  nameNormalized  String          @map("name_normalized") @db.VarChar(120)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobberProfile JobberProfile @relation(fields: [jobberProfileId], references: [id], onDelete: Cascade)
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([jobberProfileId, nameNormalized, scopeKey])
  @@index([jobberProfileId])
  @@index([jobberProfileId, kind])
  @@map("jobber_skills")
}

model JobberServiceArea {
  id                 String   @id @default(uuid()) @db.Uuid
  jobberProfileId    String   @map("jobber_profile_id") @db.Uuid
  countryCode        String   @default("BJ") @map("country_code") @db.Char(2)
  administrativeArea String?  @map("administrative_area") @db.VarChar(120)
  city               String   @db.VarChar(120)
  district           String?  @db.VarChar(120)
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  radiusKm           Decimal? @map("radius_km") @db.Decimal(6, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  jobberProfile JobberProfile @relation(fields: [jobberProfileId], references: [id], onDelete: Cascade)

  @@index([jobberProfileId, isActive])
  @@index([countryCode, city])
  @@map("jobber_service_areas")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  tokenFamily      String    @map("token_family") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("sessions")
}

model AccountToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      AccountTokenType
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("account_tokens")
}

model PhoneOtp {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  phone       String    @db.VarChar(20)
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone, createdAt(sort: Desc)])
  @@map("phone_otps")
}

model TermsAcceptance {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  termsVersion         String   @map("terms_version") @db.VarChar(20)
  privacyPolicyVersion String   @map("privacy_policy_version") @db.VarChar(20)
  acceptedAt           DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("terms_acceptances")
}

/// Montants : `clientPriceAmount` = entier en FCFA (XOF), sans subdivision.
/// Référence lisible via séquence PostgreSQL `mission_reference_seq` (pas count+1).
model Mission {
  id                       String        @id @default(uuid()) @db.Uuid
  reference                String        @unique @db.VarChar(32)
  clientUserId             String        @map("client_user_id") @db.Uuid
  serviceId                String        @map("service_id") @db.Uuid
  title                    String        @db.VarChar(160)
  description              String        @db.VarChar(4000)
  countryCode              String        @default("BJ") @map("country_code") @db.Char(2)
  city                     String        @db.VarChar(120)
  district                 String?       @db.VarChar(120)
  addressLine              String?       @map("address_line") @db.VarChar(255)
  locationNotes            String?       @map("location_notes") @db.VarChar(500)
  latitude                 Decimal?      @db.Decimal(9, 6)
  longitude                Decimal?      @db.Decimal(9, 6)
  schedulingType           MissionSchedulingType @default(ONCE) @map("scheduling_type")
  scheduleStartDate        DateTime?     @map("schedule_start_date") @db.Date
  scheduleEndDate          DateTime?     @map("schedule_end_date") @db.Date
  scheduleSameHoursDaily   Boolean?      @map("schedule_same_hours_daily")
  selectedWeekdays         MissionWeekday[] @default([]) @map("selected_weekdays")
  durationKnown            Boolean       @default(true) @map("duration_known")
  scheduledStartAt         DateTime?     @map("scheduled_start_at") @db.Timestamptz(6)
  estimatedDurationMinutes Int?          @map("estimated_duration_minutes")
  /// Nombre de Jobbers recherchés. Affectations actives = MissionAssignment(ACTIVE).
  workersNeeded            Int           @default(1) @map("workers_needed")
  pricingType              MissionPricingType @default(FIXED) @map("pricing_type")
  /// Tarif unitaire (HOURLY/DAILY) en FCFA. FIXED utilise clientPriceAmount.
  rateAmount               Int?          @map("rate_amount")
  rateScope                MissionRateScope @default(PER_JOBBER) @map("rate_scope")
  /// Estimation totale (HOURLY/DAILY) en FCFA — distinct du montant final facturé.
  estimatedAmount          Int?          @map("estimated_amount")
  /// Prix client en FCFA entiers (XOF) — jamais Float.
  clientPriceAmount        Int           @map("client_price_amount")
  currency                 String        @default("XOF") @db.Char(3)
  paymentConfirmedAt       DateTime?     @map("payment_confirmed_at") @db.Timestamptz(6)
  submittedForReviewAt     DateTime?     @map("submitted_for_review_at") @db.Timestamptz(6)
  reviewInternalNote       String?       @map("review_internal_note") @db.VarChar(2000)
  clientReviewMessage      String?       @map("client_review_message") @db.VarChar(2000)
  reviewChangeAreas        MissionReviewChangeArea[] @default([]) @map("review_change_areas")
  rejectionReasonCode      MissionRejectionReason? @map("rejection_reason_code")
  rejectionReasonText      String?       @map("rejection_reason_text") @db.VarChar(2000)
  /// Mission payée puis refusée : suivi financier manuel (module Payment futur).
  financialFollowUpRequired Boolean      @default(false) @map("financial_follow_up_required")
  minimumAge               Int           @default(16) @map("minimum_age")
  riskFlags                MissionRiskFlag[] @map("risk_flags")
  status                   MissionStatus @default(DRAFT)
  /// Legacy mono-Jobber + synchro « premier ACTIVE » pour START/END V1 (dette BO06).
  selectedJobberUserId     String?       @map("selected_jobber_user_id") @db.Uuid
  serviceNameSnapshot      String        @map("service_name_snapshot") @db.VarChar(120)
  serviceSlugSnapshot      String        @map("service_slug_snapshot") @db.VarChar(120)
  categoryNameSnapshot     String        @map("category_name_snapshot") @db.VarChar(120)
  categorySlugSnapshot     String        @map("category_slug_snapshot") @db.VarChar(120)
  publishedAt              DateTime?     @map("published_at") @db.Timestamptz(6)
  assignedAt               DateTime?     @map("assigned_at") @db.Timestamptz(6)
  confirmedAt              DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  startedAt                DateTime?     @map("started_at") @db.Timestamptz(6)
  completionRequestedAt    DateTime?     @map("completion_requested_at") @db.Timestamptz(6)
  completedAt              DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt              DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         User                   @relation("MissionClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  selectedJobber User?                  @relation("MissionSelectedJobber", fields: [selectedJobberUserId], references: [id], onDelete: SetNull)
  service        Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  applications   MissionApplication[]
  assignments    MissionAssignment[]
  verifications  MissionVerification[]
  cancellations  MissionCancellation[]
  incidents      MissionIncident[]
  statusHistory  MissionStatusHistory[]
  occurrences    MissionOccurrence[]
  media          MissionMedia[]
  payments       Payment[]

  @@index([clientUserId, status])
  @@index([selectedJobberUserId, status])
  @@index([serviceId, status])
  @@index([status, publishedAt])
  @@index([status, submittedForReviewAt])
  @@index([city, countryCode])
  @@index([pricingType])
  @@index([schedulingType])
  @@map("missions")
}

model MissionOccurrence {
  id                       String   @id @default(uuid()) @db.Uuid
  missionId                String   @map("mission_id") @db.Uuid
  occurrenceDate           DateTime @map("occurrence_date") @db.Date
  plannedStartAt           DateTime? @map("planned_start_at") @db.Timestamptz(6)
  plannedEndAt             DateTime? @map("planned_end_at") @db.Timestamptz(6)
  estimatedDurationMinutes Int?     @map("estimated_duration_minutes")
  sortOrder                Int      @default(0) @map("sort_order")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, occurrenceDate])
  @@map("mission_occurrences")
}

model MissionMedia {
  id              String           @id @default(uuid()) @db.Uuid
  missionId       String           @map("mission_id") @db.Uuid
  mediaType       MissionMediaType @default(IMAGE) @map("media_type")
  mimeType        String           @map("mime_type") @db.VarChar(120)
  sizeBytes       Int              @map("size_bytes")
  storageKey      String           @map("storage_key") @db.VarChar(512)
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  mission    Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("MissionMediaUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([missionId, sortOrder])
  @@map("mission_media")
}

/// Paiement publication Mission (mock DEV ou futur agrégateur). Jamais base64 / secrets provider.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  missionId         String        @map("mission_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  amount            Int
  currency          String        @default("XOF") @db.Char(3)
  /// MOCK | futur agrégateur (jamais confondre avec un encaissement réel si MOCK).
  provider          String        @db.VarChar(32)
  providerReference String        @unique @map("provider_reference") @db.VarChar(120)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  failedAt          DateTime?     @map("failed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([missionId, status])
  @@index([userId, createdAt])
  @@map("payments")
}

model MissionApplication {
  id           String                   @id @default(uuid()) @db.Uuid
  missionId    String                   @map("mission_id") @db.Uuid
  jobberUserId String                   @map("jobber_user_id") @db.Uuid
  message      String?                  @db.VarChar(1000)
  status       MissionApplicationStatus @default(PENDING)
  appliedAt    DateTime                 @default(now()) @map("applied_at") @db.Timestamptz(6)
  withdrawnAt  DateTime?                @map("withdrawn_at") @db.Timestamptz(6)
  selectedAt   DateTime?                @map("selected_at") @db.Timestamptz(6)
  rejectedAt   DateTime?                @map("rejected_at") @db.Timestamptz(6)
  closedAt     DateTime?                @map("closed_at") @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  mission    Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  jobber     User                @relation(fields: [jobberUserId], references: [id], onDelete: Cascade)
  assignment MissionAssignment?

  @@unique([missionId, jobberUserId])
  @@index([jobberUserId, status])
  @@index([missionId, status])
  @@map("mission_applications")
}

/// Affectation d'un Jobber sélectionné (≠ candidature). Snapshot financier à la sélection.
model MissionAssignment {
  id                 String                  @id @default(uuid()) @db.Uuid
  missionId          String                  @map("mission_id") @db.Uuid
  jobberUserId       String                  @map("jobber_user_id") @db.Uuid
  applicationId      String                  @unique @map("application_id") @db.Uuid
  status             MissionAssignmentStatus @default(ACTIVE)
  selectedAt         DateTime                @map("selected_at") @db.Timestamptz(6)
  selectedByUserId   String                  @map("selected_by_user_id") @db.Uuid
  cancelledAt        DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?                 @map("cancellation_reason") @db.VarChar(500)
  /// Brut Jobber (FCFA) figé à la sélection — base future payout.
  workerGrossAmount  Int                     @map("worker_gross_amount")
  /// Commission KingJOBS en points de base (1500 = 15 %).
  commissionRateBps  Int                     @default(1500) @map("commission_rate_bps")
  currency           String                  @default("XOF") @db.Char(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  mission      Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  jobber       User               @relation("MissionAssignmentJobber", fields: [jobberUserId], references: [id], onDelete: Restrict)
  application  MissionApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  selectedBy   User               @relation("MissionAssignmentSelector", fields: [selectedByUserId], references: [id], onDelete: Restrict)

  @@index([missionId, status])
  @@index([jobberUserId, status])
  @@map("mission_assignments")
}

model MissionVerification {
  id         String                  @id @default(uuid()) @db.Uuid
  missionId  String                  @map("mission_id") @db.Uuid
  type       MissionVerificationType
  secretHash String                  @map("secret_hash")
  expiresAt  DateTime?               @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?               @map("used_at") @db.Timestamptz(6)
  attempts   Int                     @default(0)
  maxAttempts Int                    @default(5) @map("max_attempts")
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, type, usedAt])
  @@map("mission_verifications")
}

model MissionCancellation {
  id                String                     @id @default(uuid()) @db.Uuid
  missionId         String                     @map("mission_id") @db.Uuid
  initiatedByUserId String                     @map("initiated_by_user_id") @db.Uuid
