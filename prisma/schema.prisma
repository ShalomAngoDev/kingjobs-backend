/// Notifications in-app (Jobber / Client). Extensible ; email/SMS/push restent des canaux séparés.
enum UserNotificationType {
  JOBBER_PROFILE_VERIFIED
  JOBBER_VERIFICATION_NEEDS_CHANGES
  JOBBER_VERIFICATION_REJECTED
  IDENTITY_VERIFIED
  MISSION_APPLICATION_RECEIVED
  /// Jobber sélectionné sur une mission.
  JOBBER_APPLICATION_SELECTED
  /// Candidature non retenue par le Client.
  JOBBER_APPLICATION_REJECTED
  /// Places pourvues (pas un rejet personnel).
  JOBBER_MISSION_FILLED
}

model UserNotification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      UserNotificationType
  title     String               @db.VarChar(160)
  message   String               @db.VarChar(1000)
  /// Clé d'idempotence par utilisateur (évite les doublons sur rejeu).
  dedupeKey String               @map("dedupe_key") @db.VarChar(160)
  actionUrl String?              @map("action_url") @db.VarChar(320)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notifications")
}
