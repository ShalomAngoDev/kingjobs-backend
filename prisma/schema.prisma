  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document UserDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?        @relation("DocumentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@map("user_document_events")
}

model AdminAuditEvent {
  id           String           @id @default(uuid()) @db.Uuid
  actorId      String           @map("actor_id") @db.Uuid
  action       AdminAuditAction
  resourceType String           @map("resource_type") @db.VarChar(80)
  resourceId   String           @map("resource_id") @db.VarChar(80)
  metadata     Json?
