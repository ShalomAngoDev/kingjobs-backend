# Environment
NODE_ENV=development
PORT=3001

# API
API_PREFIX=api
API_VERSION=1
SERVICE_NAME=kingjobs-api
APP_VERSION=0.1.0

# Database (Neon PostgreSQL)
# DATABASE_URL = pooled connection string (runtime)
# DIRECT_URL   = unpooled / direct connection (Prisma migrate)
DATABASE_URL=
DIRECT_URL=

# CORS — comma-separated browser origins (no wildcard with credentials)
CORS_ORIGINS=http://localhost:3000,https://kingjobs.co,https://www.kingjobs.co

# Security / HTTP
BODY_LIMIT=1mb
TRUST_PROXY=1
SWAGGER_ENABLED=true

# Rate limiting (global, excludes health via @SkipThrottle)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Optional build metadata (do not run git at request time)
GIT_SHA=
