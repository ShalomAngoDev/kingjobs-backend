# Environment
NODE_ENV=production
PORT=3001

# API
API_PREFIX=api
API_VERSION=1
SERVICE_NAME=kingjobs-api
APP_VERSION=0.1.0

# Neon PostgreSQL (même projet que Vercel WebSite)
# DATABASE_URL  = connection pooled (runtime) — chaîne « pooled » Neon
# DIRECT_URL    = connection unpooled (migrate) — chaîne « direct / unpooled » Neon
DATABASE_URL=
DIRECT_URL=

# CORS — origins exacts (comma-separated)
CORS_ORIGINS=https://kingjobs.co,https://www.kingjobs.co,http://localhost:3000
# Regex additionnelles (previews Vercel)
CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# Security / HTTP (Render = derrière proxy)
BODY_LIMIT=1mb
TRUST_PROXY=1
SWAGGER_ENABLED=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Email
RESEND_API_KEY=
EMAIL_FROM=KingJOBS <hello@kingjobs.co>
APP_WEB_URL=https://kingjobs.co

# SMS
SMS_PROVIDER=none
DEFAULT_PHONE_REGION=BJ

GIT_SHA=
