# =============================================================================
# KingJOBS API — environnement (valeurs fictives uniquement)
# Copier vers .env et renseigner. Ne jamais committer de secrets.
# =============================================================================

# development | test | production
DATABASE_ENV=development
NODE_ENV=development
PORT=3001

# API
API_PREFIX=api
API_VERSION=1
SERVICE_NAME=kingjobs-api
APP_VERSION=0.1.0

# -----------------------------------------------------------------------------
# PostgreSQL / Neon
# DATABASE_URL  = pooled (runtime)
# DIRECT_URL    = unpooled (migrate deploy)
# SHADOW_DATABASE_URL = branche Neon DÉDIÉE shadow/test — JAMAIS la production
# TEST_DATABASE_URL   = branche Neon test (si e2e DB réelle ; sinon e2e mémoire)
# KINGJOBS_PROD_DB_HOSTS = marqueurs hostname production (sans credentials)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-dev-xxxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-dev-xxxx.region.aws.neon.tech/neondb?sslmode=require
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@ep-shadow-xxxx.region.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=
KINGJOBS_PROD_DB_HOSTS=ep-orange-pine-za4ezsuf

# Override EXPLICITE uniquement pour une migration volontairement destructive
# (jamais true par défaut — ne pas activer en prod)
# ALLOW_DESTRUCTIVE_MIGRATION=false

# CORS — origins exacts (comma-separated)
CORS_ORIGINS=https://kingjobs.co,https://www.kingjobs.co,http://localhost:3000
CORS_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# Security / HTTP
BODY_LIMIT=1mb
TRUST_PROXY=1
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-chars-secret!!
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Email
RESEND_API_KEY=
EMAIL_FROM=KingJOBS <noreply@kingjobs.co>
APP_WEB_URL=https://kingjobs.co

# SMS
SMS_PROVIDER=none
DEFAULT_PHONE_REGION=BJ

GIT_SHA=

# Stockage fichiers privés KYC
# local_private = dev/Docker uniquement (interdit en production)
# object_storage = S3-compatible (prod)
# memory = tests uniquement
STORAGE_PROVIDER=local_private
FILE_STORAGE_PATH=./.data/private-uploads
STORAGE_SIGNED_URL_TTL_SECONDS=180
STORAGE_MAX_UPLOAD_BYTES=8388608

# Paiement publication Mission
# mock = simulateur DEV (aucun débit réel). Interdit en production.
# none = pas de provider (défaut fail-closed).
PAYMENT_PROVIDER=mock

# Object storage S3-compatible (valeurs factices)
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=eu-west-1
# S3_BUCKET=kingjobs-kyc-private
# S3_ACCESS_KEY_ID=AKIAEXAMPLE
# S3_SECRET_ACCESS_KEY=secret-example-not-real
# S3_FORCE_PATH_STYLE=true
